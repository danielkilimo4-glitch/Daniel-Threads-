# Build and Release Folders
bin-debug/
bin-release/
[Oo]bj/
[Bb]in/

# Other files and folders
.settings/

# Executables
*.swf
*.air
*.ipa
*.apk

# Project files, i.e. `.project`, `.actionScriptProperties` and `.flexProperties`
# should NOT be excluded as they contain compiler settings and other important
# information for Eclipse / Flash Builder.
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>DANIEL THREADS | AI Powered Streetwear</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Inter,Helvetica,Arial}
body{background:#fff;color:#111}
header{padding:16px 5%;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #eee;position:sticky;top:0;background:#fff;z-index:10}
.logo{font-weight:900;letter-spacing:4px}
.hero{background:#000;color:#fff;padding:60px 5%;display:grid;gap:20px}
.hero h1{font-size:42px;line-height:.9}
.badge{display:inline-block;background:#fff;color:#000;padding:6px 10px;font-size:10px;letter-spacing:2px;font-weight:900}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:20px}
.card{border:1px solid #eee;padding:8px}
.card img{width:100%;aspect-ratio:1;object-fit:cover;background:#f2f2f2}
.ai-box{margin:40px 5%;border:2px solid #000;padding:20px}
.ai-box h2{font-size:18px;letter-spacing:2px}
input,button{width:100%;padding:14px;margin-top:10px;border:1px solid #000}
button{background:#000;color:#fff;font-weight:800;cursor:pointer}
.pay{margin:40px 5%;background:#f7f7f7;padding:20px;border-left:4px solid #00c853}
.wa{position:fixed;bottom:20px;right:20px;background:#25D366;color:#fff;padding:14px 20px;border-radius:30px;text-decoration:none;font-weight:900;z-index:20}
#chatLog{height:140px;overflow:auto;background:#000;color:#0f0;padding:10px;margin-top:10px;font-family:monospace;font-size:12px}
@media(min-width:800px){.hero{grid-template-columns:1.2fr .8fr}.grid{grid-template-columns:repeat(4,1fr)}}
</style>
</head>
<body>
<header><div>☰</div><div class="logo">DANIEL THREADS • AI</div><div>🛒</div></header>

<section class="hero">
<div>
<span class="badge">NEW • AI POWERED STORE</span>
<h1>STREETWEAR<br>THAT GETS YOU.</h1>
<p style="opacity:.7;margin-top:10px">AI Stylist • AI Size • AI Try-On • M-Pesa Checkout</p>
<div class="grid">
<div class="card"><img src="https://images.unsplash.com/photo-1556821840-3a63f95609a7"><h3>UTILITY HOODIE</h3><b>KES 4,500</b></div>
<div class="card"><img src="https://images.unsplash.com/photo-1594633312681-425c7b97ccd1"><h3>CARGO PANTS</h3><b>KES 3,800</b></div>
</div>
</div>

<div class="ai-box">
<h2>🤖 AI STYLIST</h2>
<p style="font-size:12px;opacity:.6">Ask: "outfit for campus", "all black drip under 5k"</p>
<div id="chatLog">AI: Yo Daniel! I'm your AI stylist. What vibe you looking for?</div>
<input id="chatInput" placeholder="Type your style..." />
<button onclick="askAI()">Ask AI Stylist</button>

<h2 style="margin-top:30px">📏 AI SIZE FINDER</h2>
<input id="height" placeholder="Your height cm e.g 175" />
<input id="weight" placeholder="Your weight kg e.g 70" />
<button onclick="findSize()">Find My Size</button>
<p id="sizeResult" style="margin-top:10px;font-weight:800"></p>
</div>
</section>

<div class="pay">
<h3>💚 LIPA NA M-PESA</h3>
<p style="margin-top:8px"><b>Buy Goods Till / Send Money:</b> 0727899659 - Daniel</p>
<p style="font-size:13px;margin-top:6px">1. Go to M-Pesa > Lipa na M-Pesa<br>2. Enter 0727899659<br>3. Amount, then send screenshot on WhatsApp to confirm order</p>
<button onclick="window.open('https://wa.me/254727899659?text=Hi%20Daniel%2C%20I%20just%20paid%20via%20M-Pesa%200727899659.%20My%20order%3A')">I'VE PAID - CONFIRM ON WHATSAPP</button>
</div>

<a class="wa" href="https://wa.me/254727899659?text=Hi%20Daniel%20Threads!%20Niko%20na%20swali%20about%20your%20drip">WhatsApp Us</a>

<script>
// Simple AI Logic - no backend needed
function askAI(){
  const q = document.getElementById('chatInput').value.toLowerCase();
  const log = document.getElementById('chatLog');
  let a = "Go for Utility Hoodie + Cargo Pants - that combo never misses in Isiolo.";
  if(q.includes("date")) a = "For date night: Heavy Tee (black) + Cargo Pants + Bucket Hat. Clean, confident.";
  if(q.includes("campus")||q.includes("school")) a = "Campus drip: Utility Hoodie + Heavy Tee. Comfortable + photos ready.";
  if(q.includes("5k")||q.includes("cheap")) a = "Under 5k: Heavy Tee (2k) + Bucket Hat (1.5k) = 3.5k only. I'll hold it for you.";
  if(q.includes("black")||q.includes("all black")) a = "All-black killer fit: Utility Hoodie + Cargo Pants + Bucket Hat. Stealth mode.";
  log.innerHTML += `<br><br>You: ${q}<br>AI: ${a}`;
  log.scrollTop = log.scrollHeight;
  document.getElementById('chatInput').value="";
}
function findSize(){
  const h = parseInt(document.getElementById('height').value)||170;
  const w = parseInt(document.getElementById('weight').value)||68;
  let size = "M";
  if(h<165 && w<65) size="S";
  if(h>180 || w>80) size="L";
  if(h>185 || w>90) size="XL";
  document.getElementById('sizeResult').innerText = `AI recommends: Size ${size} (Height ${h}cm, Weight ${w}kg) - Fits 95% of customers like you`;
}
</script>
</body>
</html>